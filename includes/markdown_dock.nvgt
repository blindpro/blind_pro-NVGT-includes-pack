class markdown_dock
{
string text = "";
void heading(int level, string data)
{
string tag = "";
for(int i = 0; i<level; i++)
{
tag+="#";
}
text+=tag+" "+data+"\r\n\r\n";
}
void paragraph(string data)
{
text+=data+"\r\n\r\n";
}
void list(string data)
{
text+="- "+data+"\r\n";
}
void code_block(string lang, string code)
{
text+"````"+lang+"\r\n"+code+"\r\n````\r\n\r\n";
}
void link(string data, string url)
{
text+="["+data+"]("+url+")";
}
string get_text()
{
return text;
}
void clear()
{
text = "";
}
}