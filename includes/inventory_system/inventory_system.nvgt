//Fully pordable inventory class!
#include"dget.nvgt"
#include"item.nvgt"
class inventory
{
//The dictionary is where all the items are stored with there values. Order is the array of items to cykle threw.
dictionary counts;
dictionary items;
string[] order;
int index;
//function to add a item.
void add(item@ i, int number = 1)
{
if(counts.exists(i.name))
{
int total = dgetn(counts,i.name);
counts.set(i.name,total+number);
items.set(i.name,i);
}
else
{
counts.set(i.name,number);
items.set(i.name,i);
order.insert_last(i.name);
}
}
void add(string name, item_action@ i, int amount = 1)
{
item it(name,i,amount);
add(it);
}
//Function to remove items.
void remove(item@ i, int number)
{
if (!counts.exists(i.name))
{
return;
}
int num = dgetn(counts,i.name);
if( num-number<=0)
{
counts.delete(i.name);
items.delete(i.name);
int item_index = order.find(i.name);
if(item_index !=-1)
{
order.remove_at(item_index);
}
if (index >= order.length())
{
index = 0;
}
}
else
{
counts.set(i.name,num-number);
}
}
int get_count(item i)
{
int num = dgetn(counts,i.name,-1);
return num;
}
//This is the function to go threw your inventory.
string cykle_forward()
{
if(order.length() == 0)
{
return "no items";
}
else if(index+1 >=order.length())
{
index = 0;
return anounce_item();
}
else
{
index++;
return anounce_item();
}
}
//This is the function to go threw you inventory backwards.
string cykle_backward()
{
if(order.length() == 0)
{
return "no items";
}
else if(index-1 <0)
{
int num = order.length()-1;
index = num;
return anounce_item();
}
else
{
index--;
return anounce_item();
}
}
//Speak currently selected item.
string anounce_item()
{
int num = 	dgetn(counts,order[index]);
return order[index]+" you have "+num+".";
}
//Use items and handle item lojic.
void use(item i)
{
if(i is null)
{
return;
}
i.use();
}
//Return the currently selected item as a string.
string get_item_selection()
{
if(order.length() == 0)
{
return "";
}
else
{
return order[index];
}
}
//Check if the user has a item in there inventory.
bool hasThis(string item)
{
if(order.find(item) >-1)
{
return true;
}
else
{
return false;
}
}
void clear()
{
counts.delete_all();
items.delete_all();
order.resize(0);
}
}